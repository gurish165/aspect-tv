{
  "name": "aspect-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:network": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "check": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:package": "npm run build && electron-builder --mac --dir",
    "test": "vitest run",
    "test:playthrough": "PLAYTHROUGH=1 vitest run src/arcade/games/jetpack.playthrough.test.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "motion": "^14.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "happy-dom": "20.14.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "main": "electron/main.js",
  "description": "The Aspect bouncing logo with a classic CRT screen effect.",
  "build": {
    "appId": "inc.aspect.tv",
    "productName": "Aspect TV",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dir",
      "identity": null
    }
  }
}
